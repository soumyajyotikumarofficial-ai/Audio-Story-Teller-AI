{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run Backend",
			"type": "shell",
			"command": "cd backend; venv\\Scripts\\activate; python run.py",
			"isBackground": true,
			"group": "build"
		},
		{
			"label": "Run Frontend",
			"type": "shell",
			"command": "cd frontend/frontend-app; ng serve",
			"isBackground": true,
			"group": "build"
		}
	]
}